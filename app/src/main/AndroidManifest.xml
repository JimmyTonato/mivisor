<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Escribir con el móvil: saber qué red es Wi-Fi/Ethernet y cuál es la VPN (para no usar la IP de WARP). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      OPCIONAL (diagnóstico de Ace Stream): leer las líneas de Ace Stream (etiquetas AS/…, AceStream/…) del log
      del sistema tras abrir un canal. Android SOLO lo concede si el usuario lo hace a mano desde un ordenador:
        adb shell pm grant <paquete> android.permission.READ_LOGS
      Sin él, MiVisor funciona igual y el Registro Ace Stream explica cómo activarlo. Android 13+ pide además
      confirmación en pantalla. MiVisor guarda solo las líneas de Ace, limpias (sin IDs, URLs ni IPs).
    -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <!--
      Control de la WARP modificada (com.cloudflare.onedotonedotonedotone). Es un permiso "signature":
      solo se concede si MiVisor está firmado con la MISMA clave que WARP (ver README → Servicios rápidos).
      La declaración del permiso se añade solo en releases firmadas con la clave propia (src/warpSigned).
    -->
    <uses-permission android:name="com.mivisor.permission.CONTROL_WARP" />

    <!-- TV primero, sin dejar de funcionar en móvil/tablet. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Visibilidad de paquetes (Android 11+): reproductores que se ofrecen en "Abrir con". -->
    <queries>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="http" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="acestream" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="magnet" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="tvgram" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="tg" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="rtmp" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="rtsp" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="video/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="audio/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/*" /></intent>
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="text/plain" /></intent>
        <package android:name="com.network.tvgramplayer" />
        <!-- Servicios rápidos: WARP modificada y apps oficiales de Ace Stream (ServiceClient). -->
        <package android:name="com.cloudflare.onedotonedotonedotone" />
        <package android:name="org.acestream.media" />
        <package android:name="org.acestream.media.atv" />
        <package android:name="org.acestream.core" />
        <package android:name="org.acestream.core.atv" />
        <intent><action android:name="org.acestream.engine.service.v0.IAceStreamEngine" /></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiVisor"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          singleTask: los deep links reutilizan la instancia (onNewIntent).
          configChanges: conectar un teclado/ratón o cambiar de modo en la TV no recrea la Activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mylinkspaste" />
                <data android:scheme="mivisor" />
            </intent-filter>
        </activity>
    </application>
</manifest>
